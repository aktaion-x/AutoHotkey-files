{
  "manifest_version": 3,
  "name": "Alert on Every Tab",
  "version": "1.0",
  "description": "Shows an alert whenever a webpage is opened, except for one excluded domain.",
    "web_accessible_resources": [
    {
      "resources": ["audio.mp3"],
      "matches": ["<all_urls>"]
    }
  ],
      "icons": {
        "16": "img/icon16.png",
        "32": "img/icon32.png",
        "48": "img/icon48.png",
        "128": "img/icon128.png"
    },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://readest.com/*",
        "*://*.readest.com/*",
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
