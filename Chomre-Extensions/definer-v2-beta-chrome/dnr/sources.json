[
	{
		"id": 1,
		"priority": 1,
		"condition": {
			"urlFilter": "||www.google.com/search?embedded=1&q=*",
			"resourceTypes": ["sub_frame"]
		},
		"action": {
			"type": "modifyHeaders",
			"requestHeaders": [
				{
					"header": "user-agent",
					"operation": "set",
					"value": "Mozilla/5.0 (Linux; Android 12) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/102.0.5005.78 Mobile Safari/537.36"
				},
				{
					"header": "referer",
					"operation": "set",
					"value": "https://google.com/"
				},
				{
					"header": "origin",
					"operation": "set",
					"value": "https://google.com/"
				}
			],
			"responseHeaders": [
				{ "header": "x-frame-options", "operation": "remove" },
				{ "header": "frame-options", "operation": "remove" },
				{ "header": "content-security-policy", "operation": "remove" }
			]
		}
	},
	{
		"id": 2,
		"priority": 1,
		"condition": {
			"urlFilter": "||wikipedia.org/w/index.php*embedded=1*",
			"resourceTypes": ["sub_frame"]
		},
		"action": {
			"type": "modifyHeaders",
			"requestHeaders": [
				{
					"header": "user-agent",
					"operation": "set",
					"value": "Mozilla/5.0 (Linux; Android 15; SM-S931B Build/AP3A.240905.015.A2; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/127.0.6533.103 Mobile Safari/537.36"
				},
				{
					"header": "cookie",
					"operation": "set",
					"value": "stopMobileRedirect=false"
				}
			]
		}
	},
	{
		"id": 4,
		"priority": 1,
		"condition": {
			"urlFilter": "||www.google.com/search?igu=1&q=*",
			"resourceTypes": ["sub_frame"]
		},
		"action": {
			"type": "modifyHeaders",
			"responseHeaders": [
				{
					"header": "x-frame-options",
					"operation": "remove"
				},
				{
					"header": "frame-options",
					"operation": "remove"
				},
				{
					"header": "content-security-policy",
					"operation": "remove"
				}
			]
		}
	},
	{
		"id": 3,
		"priority": 1,
		"condition": {
			"requestDomains": ["consent.google.com"],
			"urlFilter": "||consent.google.com/*",
			"resourceTypes": ["sub_frame"]
		},
		"action": {
			"type": "modifyHeaders",
			"responseHeaders": [
				{ "header": "x-frame-options", "operation": "remove" },
				{ "header": "frame-options", "operation": "remove" },
				{ "header": "content-security-policy", "operation": "remove" }
			]
		}
	}
